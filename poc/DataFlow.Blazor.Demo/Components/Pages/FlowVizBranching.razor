@page "/flow-viz-branching"
@using DataFlow.Blazor.Components
@inject IServiceProvider ServiceProvider

<PageTitle>Branching Topology Demo</PageTitle>

<h1>DataFlow Visualization - Branching Topology (Fan-Out)</h1>

<p>This demo shows a <strong>routing block</strong> splitting flow into high and low priority processors.</p>
<p><strong>Topology:</strong> Producer → Router → [Processor-High, Processor-Low]</p>

<div style="margin: 1rem 0;">
    <button class="btn btn-primary" @onclick="StartNewFlow" disabled="@_isRunning">
        Start New Flow
    </button>
</div>

@if (_currentInvocationId != null && _eventSource != null)
{
    <FlowVisualization InvocationId="_currentInvocationId.Value" EventSourceOverride="_eventSource" />
}

@code {
    private Guid? _currentInvocationId;
    private bool _isRunning;
    private DataFlow.Blazor.Services.BranchingMockEventSource? _eventSource;

    protected override void OnInitialized()
    {
        _eventSource = ServiceProvider.GetRequiredService<DataFlow.Blazor.Services.BranchingMockEventSource>();
    }

    private void StartNewFlow()
    {
        _currentInvocationId = Guid.NewGuid();
        _isRunning = true;
        
        _ = Task.Run(async () =>
        {
            await Task.Delay(10000);
            _isRunning = false;
            await InvokeAsync(StateHasChanged);
        });
    }
}
