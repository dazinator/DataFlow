@page "/flow-viz-branching"
@using DataFlow.Blazor.Components
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Branching Topology Demo</PageTitle>

<h1>DataFlow Visualization - Branching Topology (Fan-Out)</h1>

<p>This demo shows a <strong>routing block</strong> splitting flow into high and low priority processors.</p>
<p><strong>Topology:</strong> Producer → Router → [Processor-High, Processor-Low]</p>

<div style="margin: 1rem 0;">
    <button class="btn btn-primary" @onclick="StartNewFlow" disabled="@_isRunning">
        Start New Flow
    </button>
    @if (_errorMessage is not null)
    {
        <span style="color: red; margin-left: 1rem;">@_errorMessage</span>
    }
</div>

@if (_currentInvocationId != null)
{
    <FlowVisualization InvocationId="_currentInvocationId.Value" />
}

@code {
    private Guid? _currentInvocationId;
    private bool _isRunning;
    private string? _errorMessage;

    private async Task StartNewFlow()
    {
        _isRunning = true;
        _errorMessage = null;
        _currentInvocationId = null;
        StateHasChanged();

        try
        {
            var result = await Http.PostAsJsonAsync("/flows/run/branching", (object?)null);
            if (result.IsSuccessStatusCode)
            {
                var body = await result.Content.ReadFromJsonAsync<RunResult>();
                _currentInvocationId = body?.InvocationId;
            }
            else
            {
                _errorMessage = $"Server error: {result.StatusCode}";
                _isRunning = false;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            _isRunning = false;
        }
    }

    private record RunResult(Guid InvocationId);
}
