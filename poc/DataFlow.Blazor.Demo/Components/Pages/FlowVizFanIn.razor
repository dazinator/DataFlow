@page "/flow-viz-fanin"
@using DataFlow.Blazor.Components
@inject IServiceProvider ServiceProvider

<PageTitle>Fan-In Topology Demo</PageTitle>

<h1>DataFlow Visualization - Fan-In Topology</h1>

<p>This demo shows <strong>multiple producers</strong> merging through a buffer block.</p>
<p><strong>Topology:</strong> [Producer-A, Producer-B] → Buffer → Batch → Processor</p>

<div style="margin: 1rem 0;">
    <button class="btn btn-primary" @onclick="StartNewFlow" disabled="@_isRunning">
        Start New Flow
    </button>
</div>

@if (_currentInvocationId != null && _eventSource != null)
{
    <FlowVisualization InvocationId="_currentInvocationId.Value" EventSourceOverride="_eventSource" />
}

@code {
    private Guid? _currentInvocationId;
    private bool _isRunning;
    private DataFlow.Blazor.Services.FanInMockEventSource? _eventSource;

    protected override void OnInitialized()
    {
        _eventSource = ServiceProvider.GetRequiredService<DataFlow.Blazor.Services.FanInMockEventSource>();
    }

    private void StartNewFlow()
    {
        _currentInvocationId = Guid.NewGuid();
        _isRunning = true;
        
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(10000);
                _isRunning = false;
                await InvokeAsync(StateHasChanged);
            }
            catch (Exception)
            {
                // Swallow exceptions from the background task to avoid unobserved task exceptions
            }
        });
    }
}
