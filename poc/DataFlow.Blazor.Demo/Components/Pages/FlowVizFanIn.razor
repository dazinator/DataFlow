@page "/flow-viz-fanin"
@using DataFlow.Blazor.Components
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Fan-In Topology Demo</PageTitle>

<h1>DataFlow Visualization - Fan-In Topology</h1>

<p>This demo shows <strong>multiple producers</strong> merging through a buffer block.</p>
<p><strong>Topology:</strong> [Producer-A, Producer-B] → Buffer → Batch → Processor</p>

<div style="margin: 1rem 0;">
    <button class="btn btn-primary" @onclick="StartNewFlow" disabled="@_isRunning">
        Start New Flow
    </button>
    @if (_errorMessage is not null)
    {
        <span style="color: red; margin-left: 1rem;">@_errorMessage</span>
    }
</div>

@if (_currentInvocationId != null)
{
    <FlowVisualization InvocationId="_currentInvocationId.Value" />
}

@code {
    private Guid? _currentInvocationId;
    private bool _isRunning;
    private string? _errorMessage;

    private async Task StartNewFlow()
    {
        _isRunning = true;
        _errorMessage = null;
        _currentInvocationId = null;
        StateHasChanged();

        try
        {
            var result = await Http.PostAsJsonAsync("/flows/run/fanin", (object?)null);
            if (result.IsSuccessStatusCode)
            {
                var body = await result.Content.ReadFromJsonAsync<RunResult>();
                _currentInvocationId = body?.InvocationId;
            }
            else
            {
                _errorMessage = $"Server error: {result.StatusCode}";
                _isRunning = false;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            _isRunning = false;
        }
    }

    private record RunResult(Guid InvocationId);
}
