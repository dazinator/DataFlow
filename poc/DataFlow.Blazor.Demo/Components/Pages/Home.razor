@page "/"
@using DataFlow.Blazor.Components
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>DataFlow Runs</PageTitle>

<h1>DataFlow Runs</h1>

<div style="display: flex; gap: 0.5rem; margin: 1rem 0 1.5rem;">
    <button class="btn btn-primary" @onclick='() => RunFlow("linear")'>
        Run Linear
    </button>
    <button class="btn btn-primary" @onclick='() => RunFlow("branching")'>
        Run Branching
    </button>
    <button class="btn btn-primary" @onclick='() => RunFlow("fanin")'>
        Run Fan-In
    </button>
    @if (_error is not null)
    {
        <span style="color: #dc3545; align-self: center; margin-left: 0.5rem;">@_error</span>
    }
</div>

<FlowRunsList />

@code {
    private string? _error;

    private async Task RunFlow(string topology)
    {
        _error = null;
        try
        {
            var result = await Http.PostAsJsonAsync($"/flows/run/{topology}", (object?)null);
            if (!result.IsSuccessStatusCode)
                _error = $"Server error: {result.StatusCode}";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
