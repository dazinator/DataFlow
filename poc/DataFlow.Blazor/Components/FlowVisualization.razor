@using System.Threading
@inject IEventSource EventSource
@implements IDisposable

<div class="flow-visualization">
    @if (_state != null)
    {
        <FlowStatusPanel State="_state" />

        @* Thin header bar — holds trigger icon and future toolbar items *@
        @if (!string.IsNullOrEmpty(_state.TriggerParamsJson) || _state.Channels.Count > 0)
        {
            <div class="diagram-header-bar">
                @if (!string.IsNullOrEmpty(_state.TriggerParamsJson))
                {
                    <button class="trigger-icon-btn @(_selection is TriggerSelected ? "active" : "")"
                            title="Trigger parameters"
                            @onclick="ToggleTrigger">
                        ⚡ Trigger
                    </button>
                }
                @if (_state.Channels.Count > 0)
                {
                    <button class="trigger-icon-btn @(_selection is BuffersSelected ? "active" : "")"
                            title="Buffer health"
                            @onclick="ToggleBuffers">
                        ◫ Buffers
                    </button>
                }
                <button class="trigger-icon-btn @(_selection is EventHistorySelected ? "active" : "")"
                        title="Flow event history"
                        @onclick="ToggleEventHistory">
                    ☰ History
                </button>
            </div>
        }

        @* Diagram + detail pane side-by-side *@
        <div class="diagram-area">
            <div class="diagram-svg-wrap">
                <FlowDiagram State="_state"
                             Selection="_selection"
                             OnSelectionChanged="OnSelectionChanged" />
            </div>

            @if (_selection is not null)
            {
                <DetailPane State="_state"
                            Selection="_selection"
                            OnClose="ClosePane" />
            }
        </div>
    }
    else
    {
        <div class="loading">Loading flow visualization...</div>
    }
</div>

@code {
    [Parameter]
    public Guid InvocationId { get; set; }

    [Parameter]
    public IEventSource? EventSourceOverride { get; set; }

    private FlowExecutionState? _state;
    private EventProcessor? _processor;
    private CancellationTokenSource? _cts;
    private SelectedObject? _selection;

    protected override async Task OnInitializedAsync()
    {
        _processor = new EventProcessor(InvocationId);
        _state = _processor.State;

        // Start listening to events
        _cts = new CancellationTokenSource();
        _ = Task.Run(async () => await ListenToEventsAsync(_cts.Token));
    }

    private async Task ListenToEventsAsync(CancellationToken cancellationToken)
    {
        try
        {
            var eventSource = EventSourceOverride ?? EventSource;

            // Try to get snapshot first for fast initial load
            var snapshot = await eventSource.GetSnapshotAsync(InvocationId, cancellationToken);
            if (snapshot != null)
            {
                _processor!.ApplySnapshot(snapshot);

                // Populate EventLog with structural events already folded into the snapshot.
                // These are applied to the log only — not re-processed for state — so that
                // viewing a completed flow still shows event history without regressing state.
                var auditLog = await eventSource.GetAuditLogAsync(InvocationId, cancellationToken);
                _processor.ApplyAuditLog(auditLog);

                await InvokeAsync(StateHasChanged);
            }

            // Process real-time events with batched rendering.
            // Coalescing rapid startup bursts (multiple BlockStartedEvents before any
            // ChannelStatsEvents) into a single render prevents the topology from laying
            // out in a column and then jumping when edges arrive.
            var lastRender = DateTime.UtcNow; // suppress an immediate first-event render
            const int MinRenderIntervalMs = 200;

            await foreach (var evt in eventSource.GetEventsAsync(InvocationId, cancellationToken).WithCancellation(cancellationToken))
            {
                _processor!.ProcessEvent(evt);

                if ((DateTime.UtcNow - lastRender).TotalMilliseconds >= MinRenderIntervalMs)
                {
                    lastRender = DateTime.UtcNow;
                    await InvokeAsync(StateHasChanged);
                }
            }

            // Always render the final state once the stream ends.
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // Expected when component is disposed
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error processing events: {ex.Message}");
        }
    }

    private void ToggleTrigger()
    {
        _selection = _selection is TriggerSelected ? null : new TriggerSelected();
    }

    private void ToggleBuffers()
    {
        _selection = _selection is BuffersSelected ? null : new BuffersSelected();
    }

    private void ToggleEventHistory()
    {
        _selection = _selection is EventHistorySelected ? null : new EventHistorySelected();
    }

    private void OnSelectionChanged(SelectedObject? next) => _selection = next;

    private void ClosePane() => _selection = null;

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
