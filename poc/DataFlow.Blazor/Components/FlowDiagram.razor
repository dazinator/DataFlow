@* Simple SVG-based flow diagram *@

<div class="flow-diagram">
    <svg width="100%" height="600" style="border: 1px solid #dee2e6; border-radius: 8px; background: white;">
        @{
            var blocksList = State.Blocks.ToList();
            int totalBlocks = blocksList.Count;
            double spacing = totalBlocks > 0 ? 800.0 / totalBlocks : 200;
            double startX = 100;
            double y = 300;
        }

        @* Draw connections (edges) first so they appear behind nodes *@
        @for (int i = 0; i < blocksList.Count - 1; i++)
        {
            var x1 = startX + (i * spacing) + 75;  // Center of current block
            var x2 = startX + ((i + 1) * spacing) - 75;  // Left edge of next block
            
            var sourceBlock = blocksList[i].Value;
            var targetBlock = blocksList[i + 1].Value;
            
            <g class="edge">
                @* Arrow line *@
                <line x1="@x1" y1="@y" x2="@x2" y2="@y" 
                      stroke="#666" stroke-width="2" marker-end="url(#arrowhead)" />
                
                @* Channel stats if available *@
                @if (State.Channels.TryGetValue(blocksList[i].Key, out var channelState))
                {
                    var midX = (x1 + x2) / 2;
                    var midY = y - 20;
                    var channelText = $"{channelState.CurrentCount}/{channelState.BufferCapacity} ({channelState.BufferUtilizationPercent:F0}%)";
                    
                    <svg:text x="@midX" y="@midY" text-anchor="middle" font-size="11" fill="#666">@channelText</svg:text>
                }
            </g>
        }

        @* Arrow marker definition *@
        <defs>
            <marker id="arrowhead" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
                <polygon points="0 0, 10 3, 0 6" fill="#666" />
            </marker>
        </defs>

        @* Draw blocks (nodes) *@
        @for (int i = 0; i < blocksList.Count; i++)
        {
            var (blockName, blockState) = blocksList[i];
            var x = startX + (i * spacing);
            
            var statusClass = GetBlockStatusClass(blockState.State);
            var fillColor = GetBlockFillColor(blockState.State);
            var borderColor = GetBlockBorderColor(blockState.State);
            
            <g class="block @statusClass" transform="translate(@x, @y)">
                @* Block rectangle *@
                <rect x="-75" y="-50" width="150" height="100" rx="8"
                      fill="@fillColor" stroke="@borderColor" stroke-width="3" />
                
                @* Block name *@
                <text x="0" y="-15" text-anchor="middle" font-weight="600" font-size="14" fill="#333">
                    @blockName
                </text>
                
                @* Block type *@
                <text x="0" y="5" text-anchor="middle" font-size="11" fill="#666">
                    @blockState.BlockType
                </text>
                
                @* Items processed *@
                <text x="0" y="25" text-anchor="middle" font-size="12" fill="#333">
                    @blockState.ItemsProcessed.ToString("N0") items
                </text>
                
                @* Status indicator *@
                <circle cx="65" cy="-40" r="6" fill="@GetStatusIndicatorColor(blockState.State)" />
            </g>
        }
    </svg>
</div>

@code {
    [Parameter]
    public FlowExecutionState State { get; set; } = null!;

    private string GetBlockStatusClass(Events.BlockState state)
    {
        return state switch
        {
            Events.BlockState.Running => "block-running",
            Events.BlockState.Completed => "block-completed",
            Events.BlockState.Failed => "block-failed",
            _ => "block-idle"
        };
    }

    private string GetBlockFillColor(Events.BlockState state)
    {
        return state switch
        {
            Events.BlockState.Running => "#fff9e6",
            Events.BlockState.Completed => "#e8f5e9",
            Events.BlockState.Failed => "#ffebee",
            _ => "#ffffff"
        };
    }

    private string GetBlockBorderColor(Events.BlockState state)
    {
        return state switch
        {
            Events.BlockState.Running => "#ffc107",
            Events.BlockState.Completed => "#28a745",
            Events.BlockState.Failed => "#dc3545",
            _ => "#6c757d"
        };
    }

    private string GetStatusIndicatorColor(Events.BlockState state)
    {
        return state switch
        {
            Events.BlockState.Running => "#ffc107",
            Events.BlockState.Completed => "#28a745",
            Events.BlockState.Failed => "#dc3545",
            _ => "#6c757d"
        };
    }
}
