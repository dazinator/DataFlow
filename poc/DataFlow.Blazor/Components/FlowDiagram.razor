@* SVG-based flow diagram with branching topology support *@

<div class="flow-diagram">
    @{
        var topology = FlowTopology.Analyze(State.Blocks, State.Channels);
        var positions = GetOrComputePositions(topology);
        var flowDone = State.State is FlowState.Completed or FlowState.Failed;
        var svgWidth  = ComputeSvgWidth(topology);
        var svgHeight = ComputeSvgHeight(topology);
    }
    <svg width="@svgWidth" height="@svgHeight" style="border: 1px solid #dee2e6; border-radius: 8px; background: white; display: block;">

        @* Draw connections (edges) first so they appear behind nodes *@
        @foreach (var (sourceBlock, targets) in topology.Connections)
        {
            if (!positions.ContainsKey(sourceBlock)) continue;

            var (x1, y1) = positions[sourceBlock];

            foreach (var targetBlock in targets)
            {
                if (!positions.ContainsKey(targetBlock)) continue;

                var (x2, y2) = positions[targetBlock];

                @* Check if this is a competing edge *@
                var isCompeting = State.Channels.TryGetValue((sourceBlock, targetBlock), out var edgeChannel)
                                  && edgeChannel!.IsCompeting;
                var edgeStroke  = isCompeting ? CompetingEdgeColor : "#666";
                var strokeDash  = isCompeting ? "6 3" : null;
                var markerRef   = isCompeting ? "url(#arrowhead-competing)" : "url(#arrowhead)";

                <g class="edge @(isCompeting ? "edge-competing" : "")">
                    @* Arrow line - use curves for better visual clarity *@
                    @if (Math.Abs(y1 - y2) > 10)
                    {
                        @* Curved path for branching *@
                        <path d="@GenerateCurvedPath(x1, y1, x2, y2)"
                              stroke="@edgeStroke" stroke-width="2" fill="none"
                              stroke-dasharray="@strokeDash"
                              marker-end="@markerRef" />
                    }
                    else
                    {
                        @* Straight line for linear flow *@
                        <line x1="@x1" y1="@y1" x2="@x2" y2="@y2"
                              stroke="@edgeStroke" stroke-width="2"
                              stroke-dasharray="@strokeDash"
                              marker-end="@markerRef" />
                    }


                    @* Item type label — shown above the edge midpoint when the source block has a known output type.
                       Offset is increased when a buffer pill is present so the label clears the pill rect (Y-12..Y+6). *@
                    @if (State.Blocks.TryGetValue(sourceBlock, out var srcBlock) && srcBlock.OutputItemLabel is { } itemLabel)
                    {
                        var hasPill = State.Channels.TryGetValue((sourceBlock, targetBlock), out var pillCh)
                                      && pillCh!.BufferCapacity > 0;
                        var labelX = (x1 + x2) / 2;
                        var labelY = (y1 + y2) / 2 - (hasPill ? 26 : 12);
                        <svg:text x="@labelX" y="@labelY" text-anchor="middle"
                                  font-size="10" font-style="italic" fill="#888">@itemLabel</svg:text>
                    }

                    @* Buffer health pill — hidden whenever the buffer is empty *@
                    @if (State.Channels.TryGetValue((sourceBlock, targetBlock), out var channelState))
                    {
                        if (channelState.CurrentCount > 0)
                        {
                            var midX = (x1 + x2) / 2;
                            var midY = (y1 + y2) / 2;
                            <BufferPill Channel="channelState" X="midX" Y="midY" />
                        }
                    }
                </g>
            }
        }

        @* Arrow marker definition *@
        <defs>
            <marker id="arrowhead" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
                <polygon points="0 0, 10 3, 0 6" fill="#666" />
            </marker>
            @* Competing-edge arrowhead — purple, matches the dashed stroke colour *@
            <marker id="arrowhead-competing" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
                <polygon points="0 0, 10 3, 0 6" fill="@CompetingEdgeColor" />
            </marker>
        </defs>

        @* Draw blocks (nodes) *@
        @foreach (var (blockName, blockState) in State.Blocks)
        {
            if (!positions.ContainsKey(blockName)) continue;

            var (x, y) = positions[blockName];
            var statusClass = GetBlockStatusClass(blockState.State);
            var fillColor = GetBlockFillColor(blockState.State);
            var isSelected = Selection is BlockSelected bs && bs.BlockName == blockName;
            var borderColor = isSelected ? "#0d6efd" : GetBlockBorderColor(blockState.State);
            var strokeWidth = isSelected ? "4" : "3";
            var capturedName = blockName;

            @* Determine which stat sections to show *@
            var isRunning = blockState.State is Events.BlockState.Running;
            var showConsumed = blockState.ItemsConsumed > 0;
            var showProduced = blockState.ItemsProduced > 0;
            var hasStats = showConsumed || showProduced;

            @* Shift name/type upward when the bottom stat row is present *@
            var nameY = hasStats ? -18 : -10;
            var typeY = hasStats ? -4  :  5;

            @* Resolve display title: prefer configured DisplayName, fall back to block name *@
            var displayTitle = blockState.DisplayName ?? blockName;
            var titleLabel = displayTitle.Length > 18 ? displayTitle[..17] + "…" : displayTitle;

            <g class="block @statusClass" transform="translate(@x, @y)"
               style="cursor: pointer;"
               @onclick="() => SelectBlock(capturedName)">
                @* Tooltip showing full name on hover *@
                <svg:title>@displayTitle</svg:title>
                @* Selection highlight ring *@
                @if (isSelected)
                {
                    <rect x="-80" y="-55" width="160" height="110" rx="11"
                          fill="none" stroke="#0d6efd" stroke-width="2" opacity="0.35" />
                }
                @* Block rectangle *@
                <rect x="-75" y="-50" width="150" height="100" rx="8"
                      fill="@fillColor" stroke="@borderColor" stroke-width="@strokeWidth" />

                @* Block name *@
                <svg:text x="0" y="@nameY" text-anchor="middle" font-weight="600" font-size="14" fill="#333">@titleLabel</svg:text>

                @* Block type *@
                <svg:text x="0" y="@typeY" text-anchor="middle" font-size="11" fill="#666">@blockState.BlockType</svg:text>

                @* Bottom stat row: divider + consumed (left) / produced (right) *@
                @if (hasStats)
                {
                    @* Horizontal divider separating identity from stats *@
                    <line x1="-65" y1="12" x2="65" y2="12" stroke="#ccc" stroke-width="1" opacity="0.7" />

                    @* Left side — consumption stats (absent for source blocks) *@
                    @if (showConsumed)
                    {
                        <svg:text x="-60" y="32" text-anchor="start" font-size="11" fill="#555">in @FormatStatCount(blockState.ItemsConsumed, blockState.InputRatePerSecond, isRunning)</svg:text>
                    }

                    @* Right side — production stats (absent for sink blocks) *@
                    @if (showProduced)
                    {
                        <svg:text x="60" y="32" text-anchor="end" font-size="11" fill="#555">@FormatStatCount(blockState.ItemsProduced, blockState.ProductionRatePerSecond, isRunning) out</svg:text>
                    }
                }

                @* Status indicator *@
                <circle cx="65" cy="-40" r="6" fill="@GetStatusIndicatorColor(blockState.State)" />
            </g>
        }
    </svg>
</div>

@code {
    [Parameter]
    public FlowExecutionState State { get; set; } = null!;

    [Parameter]
    public SelectedObject? Selection { get; set; }

    [Parameter]
    public EventCallback<SelectedObject?> OnSelectionChanged { get; set; }

    // Layout cache — positions are only recomputed when the topology structure changes
    // (blocks or edges added/removed).  Recalculating on every render causes the graph
    // to jump mid-stream as new nodes land before their connecting edges arrive.
    private Dictionary<string, (double x, double y)>? _cachedPositions;
    private string _cachedTopologyKey = "";

    // Competing-edge visual style — used for stroke colour, arrowhead fill, and badge text.
    private const string CompetingEdgeColor = "#8B5CF6";

    private Dictionary<string, (double x, double y)> GetOrComputePositions(FlowTopology topology)
    {
        var key = BuildTopologyKey(topology);
        if (key != _cachedTopologyKey || _cachedPositions is null)
        {
            _cachedTopologyKey = key;
            _cachedPositions = CalculateBlockPositions(topology);
        }
        return _cachedPositions;
    }

    private static string BuildTopologyKey(FlowTopology topology)
    {
        // A compact fingerprint: sorted block names + sorted edge pairs.
        var blocks = string.Join(",", topology.BlockPositions.Keys.OrderBy(x => x));
        var edges = string.Join(";", topology.Connections
            .SelectMany(kv => kv.Value.Select(t => $"{kv.Key}>{t}"))
            .OrderBy(x => x));
        return $"{blocks}|{edges}";
    }

    private async Task SelectBlock(string blockName)
    {
        var next = Selection is BlockSelected bs && bs.BlockName == blockName
            ? null          // clicking selected block deselects
            : (SelectedObject?)new BlockSelected(blockName);
        await OnSelectionChanged.InvokeAsync(next);
    }

    private Dictionary<string, (double x, double y)> CalculateBlockPositions(FlowTopology topology)
    {
        var positions = new Dictionary<string, (double x, double y)>();

        // Group blocks by layer
        var layers = new Dictionary<int, List<string>>();
        foreach (var (blockName, (layer, position)) in topology.BlockPositions)
        {
            if (!layers.ContainsKey(layer))
                layers[layer] = new List<string>();
            layers[layer].Add(blockName);
        }

        // Layout constants
        const double layerSpacing = 300;  // Increased horizontal spacing
        const double blockSpacing = 150;   // Vertical spacing between blocks in same layer
        const double startX = 150;
        const double startY = 300;

        foreach (var (layer, blocks) in layers)
        {
            var x = startX + (layer * layerSpacing);

            // Center blocks vertically within the layer
            var totalHeight = (blocks.Count - 1) * blockSpacing;
            var yStart = startY - (totalHeight / 2);

            for (int i = 0; i < blocks.Count; i++)
            {
                var y = yStart + (i * blockSpacing);
                positions[blocks[i]] = (x, y);
            }
        }

        return positions;
    }

    /// <summary>
    /// Formats a stat count for the bottom row of a block node.
    /// While running, appends the live rate. Position (left/right) communicates consumed vs produced.
    /// </summary>
    private static string FormatStatCount(long count, double rate, bool isRunning)
    {
        var formatted = FormatCount(count);
        if (isRunning && rate > 0)
            return $"{formatted} · {(long)Math.Round(rate)}/s";
        return formatted;
    }

    private string GetBlockStatusClass(Events.BlockState state)
    {
        return state switch
        {
            Events.BlockState.Running => "block-running",
            Events.BlockState.Completed => "block-completed",
            Events.BlockState.Failed => "block-failed",
            _ => "block-idle"
        };
    }

    private string GetBlockFillColor(Events.BlockState state)
    {
        return state switch
        {
            Events.BlockState.Running => "#fff9e6",
            Events.BlockState.Completed => "#e8f5e9",
            Events.BlockState.Failed => "#ffebee",
            _ => "#ffffff"
        };
    }

    private string GetBlockBorderColor(Events.BlockState state)
    {
        return state switch
        {
            Events.BlockState.Running => "#ffc107",
            Events.BlockState.Completed => "#28a745",
            Events.BlockState.Failed => "#dc3545",
            _ => "#6c757d"
        };
    }

    private string GetStatusIndicatorColor(Events.BlockState state)
    {
        return state switch
        {
            Events.BlockState.Running => "#ffc107",
            Events.BlockState.Completed => "#28a745",
            Events.BlockState.Failed => "#dc3545",
            _ => "#6c757d"
        };
    }

    private static string FormatCount(long count) =>
        count >= 1_000_000 ? $"{count / 1_000_000.0:F1}M" :
        count >= 1_000     ? $"{count / 1_000.0:F1}k" :
        count.ToString();

    private string GenerateCurvedPath(double x1, double y1, double x2, double y2)
    {
        var midX = (x1 + x2) / 2;
        return $"M {x1} {y1} Q {midX} {y1}, {midX} {(y1 + y2) / 2} T {x2} {y2}";
    }

    /// <summary>
    /// Computes the SVG canvas width from the rightmost block column so the diagram
    /// never clips horizontally regardless of how many layers are present.
    /// </summary>
    private static int ComputeSvgWidth(FlowTopology topology)
    {
        const double layerSpacing  = 300;
        const double startX        = 150;
        const double blockHalfWidth = 75;
        const double rightPadding  = 100;

        var maxLayer = topology.BlockPositions.Values
            .Select(p => p.Layer)
            .DefaultIfEmpty(0)
            .Max();

        return Math.Max(600, (int)(startX + maxLayer * layerSpacing + blockHalfWidth + rightPadding));
    }

    /// <summary>
    /// Computes the SVG canvas height from the tallest block column.
    /// </summary>
    private static int ComputeSvgHeight(FlowTopology topology)
    {
        const double blockSpacing   = 150;
        const double startY         = 300;
        const double blockHalfHeight = 50;
        const double vertPadding    = 80;

        var maxPosition = topology.BlockPositions.Values
            .Select(p => p.Position)
            .DefaultIfEmpty(0)
            .Max();

        // Layers are centred on startY; the tallest column extends above and below.
        // Find the actual max y extent across all layers.
        var maxBlocksInAnyLayer = topology.BlockPositions.Values
            .GroupBy(p => p.Layer)
            .Select(g => g.Count())
            .DefaultIfEmpty(1)
            .Max();

        var totalColumnHeight = (maxBlocksInAnyLayer - 1) * blockSpacing;
        var bottomEdge = startY + totalColumnHeight / 2 + blockHalfHeight;

        return Math.Max(400, (int)(bottomEdge + vertPadding));
    }
}
