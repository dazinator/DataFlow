@* SVG-based flow diagram with branching topology support *@

<div class="flow-diagram">
    <svg width="100%" height="600" style="border: 1px solid #dee2e6; border-radius: 8px; background: white;">
        @{
            var topology = FlowTopology.Analyze(State.Blocks, State.Channels);
            var positions = CalculateBlockPositions(topology);
            var flowDone = State.State is FlowState.Completed or FlowState.Failed;
        }

        @* Draw connections (edges) first so they appear behind nodes *@
        @foreach (var (sourceBlock, targets) in topology.Connections)
        {
            if (!positions.ContainsKey(sourceBlock)) continue;

            var (x1, y1) = positions[sourceBlock];

            foreach (var targetBlock in targets)
            {
                if (!positions.ContainsKey(targetBlock)) continue;

                var (x2, y2) = positions[targetBlock];

                <g class="edge">
                    @* Arrow line - use curves for better visual clarity *@
                    @if (Math.Abs(y1 - y2) > 10)
                    {
                        @* Curved path for branching *@
                        <path d="@GenerateCurvedPath(x1, y1, x2, y2)" stroke="#666" stroke-width="2" fill="none" marker-end="url(#arrowhead)" />
                    }
                    else
                    {
                        @* Straight line for linear flow *@
                        <line x1="@x1" y1="@y1" x2="@x2" y2="@y2"
                              stroke="#666" stroke-width="2" marker-end="url(#arrowhead)" />
                    }

                    @* Buffer health pill — hidden when flow is done and buffer is empty *@
                    @if (State.Channels.TryGetValue((sourceBlock, targetBlock), out var channelState))
                    {
                        var hideEmpty = flowDone && channelState.CurrentCount == 0;
                        if (!hideEmpty)
                        {
                            var midX = (x1 + x2) / 2;
                            var midY = (y1 + y2) / 2;
                            <BufferPill Channel="channelState" X="midX" Y="midY" />
                        }
                    }
                </g>
            }
        }

        @* Arrow marker definition *@
        <defs>
            <marker id="arrowhead" markerWidth="10" markerHeight="10" refX="9" refY="3" orient="auto">
                <polygon points="0 0, 10 3, 0 6" fill="#666" />
            </marker>
        </defs>

        @* Draw blocks (nodes) *@
        @foreach (var (blockName, blockState) in State.Blocks)
        {
            if (!positions.ContainsKey(blockName)) continue;

            var (x, y) = positions[blockName];
            var statusClass = GetBlockStatusClass(blockState.State);
            var fillColor = GetBlockFillColor(blockState.State);
            var isSelected = Selection is BlockSelected bs && bs.BlockName == blockName;
            var borderColor = isSelected ? "#0d6efd" : GetBlockBorderColor(blockState.State);
            var strokeWidth = isSelected ? "4" : "3";
            var capturedName = blockName;

            @* Determine which stat lines to show *@
            var isRunning = blockState.State is Events.BlockState.Running;
            var showConsumed = blockState.ItemsConsumed > 0;
            var showProduced = blockState.ItemsProduced > 0;
            var hasStats = showConsumed || showProduced;

            @* Vertical layout: name, type, then 0-2 stat lines *@
            @* Compress name/type upward when stats are present *@
            var nameY    = hasStats ? -20 : -15;
            var typeY    = hasStats ? -7  :  5;

            <g class="block @statusClass" transform="translate(@x, @y)"
               style="cursor: pointer;"
               @onclick="() => SelectBlock(capturedName)">
                @* Selection highlight ring *@
                @if (isSelected)
                {
                    <rect x="-80" y="-55" width="160" height="110" rx="11"
                          fill="none" stroke="#0d6efd" stroke-width="2" opacity="0.35" />
                }
                @* Block rectangle *@
                <rect x="-75" y="-50" width="150" height="100" rx="8"
                      fill="@fillColor" stroke="@borderColor" stroke-width="@strokeWidth" />

                @* Block name *@
                <svg:text x="0" y="@nameY" text-anchor="middle" font-weight="600" font-size="14" fill="#333">@blockName</svg:text>

                @* Block type *@
                <svg:text x="0" y="@typeY" text-anchor="middle" font-size="11" fill="#666">@blockState.BlockType</svg:text>

                @* Stat lines — consumption then production *@
                @if (hasStats)
                {
                    var statLines = new System.Collections.Generic.List<string>();
                    if (showConsumed) statLines.Add(FormatConsumedStat(blockState, isRunning));
                    if (showProduced) statLines.Add(FormatProducedStat(blockState, isRunning));

                    @* Centre the stat lines in the lower half of the block *@
                    var lineCount = statLines.Count;
                    var firstY = lineCount == 1 ? 16 : 10;
                    for (int si = 0; si < lineCount; si++)
                    {
                        var lineY = firstY + si * 13;
                        <svg:text x="0" y="@lineY" text-anchor="middle" font-size="10" fill="#555">@statLines[si]</svg:text>
                    }
                }

                @* Status indicator *@
                <circle cx="65" cy="-40" r="6" fill="@GetStatusIndicatorColor(blockState.State)" />
            </g>
        }
    </svg>
</div>

@code {
    [Parameter]
    public FlowExecutionState State { get; set; } = null!;

    [Parameter]
    public SelectedObject? Selection { get; set; }

    [Parameter]
    public EventCallback<SelectedObject?> OnSelectionChanged { get; set; }

    private async Task SelectBlock(string blockName)
    {
        var next = Selection is BlockSelected bs && bs.BlockName == blockName
            ? null          // clicking selected block deselects
            : (SelectedObject?)new BlockSelected(blockName);
        await OnSelectionChanged.InvokeAsync(next);
    }

    private Dictionary<string, (double x, double y)> CalculateBlockPositions(FlowTopology topology)
    {
        var positions = new Dictionary<string, (double x, double y)>();

        // Group blocks by layer
        var layers = new Dictionary<int, List<string>>();
        foreach (var (blockName, (layer, position)) in topology.BlockPositions)
        {
            if (!layers.ContainsKey(layer))
                layers[layer] = new List<string>();
            layers[layer].Add(blockName);
        }

        // Layout constants
        const double layerSpacing = 300;  // Increased horizontal spacing
        const double blockSpacing = 150;   // Vertical spacing between blocks in same layer
        const double startX = 150;
        const double startY = 300;

        foreach (var (layer, blocks) in layers)
        {
            var x = startX + (layer * layerSpacing);

            // Center blocks vertically within the layer
            var totalHeight = (blocks.Count - 1) * blockSpacing;
            var yStart = startY - (totalHeight / 2);

            for (int i = 0; i < blocks.Count; i++)
            {
                var y = yStart + (i * blockSpacing);
                positions[blocks[i]] = (x, y);
            }
        }

        return positions;
    }

    /// <summary>Formats the consumed stat line for a block node.</summary>
    private static string FormatConsumedStat(Models.BlockState block, bool isRunning)
    {
        var count = FormatCount(block.ItemsConsumed);
        if (isRunning)
        {
            var rate = (long)Math.Round(block.InputRatePerSecond);
            return $"↓ {count} · {rate}/s";
        }
        return $"↓ {count} consumed";
    }

    /// <summary>Formats the produced stat line for a block node.</summary>
    private static string FormatProducedStat(Models.BlockState block, bool isRunning)
    {
        var count = FormatCount(block.ItemsProduced);
        if (isRunning)
        {
            var rate = (long)Math.Round(block.ProductionRatePerSecond);
            return $"↑ {count} · {rate}/s";
        }
        return $"↑ {count} produced";
    }

    private string GetBlockStatusClass(Events.BlockState state)
    {
        return state switch
        {
            Events.BlockState.Running => "block-running",
            Events.BlockState.Completed => "block-completed",
            Events.BlockState.Failed => "block-failed",
            _ => "block-idle"
        };
    }

    private string GetBlockFillColor(Events.BlockState state)
    {
        return state switch
        {
            Events.BlockState.Running => "#fff9e6",
            Events.BlockState.Completed => "#e8f5e9",
            Events.BlockState.Failed => "#ffebee",
            _ => "#ffffff"
        };
    }

    private string GetBlockBorderColor(Events.BlockState state)
    {
        return state switch
        {
            Events.BlockState.Running => "#ffc107",
            Events.BlockState.Completed => "#28a745",
            Events.BlockState.Failed => "#dc3545",
            _ => "#6c757d"
        };
    }

    private string GetStatusIndicatorColor(Events.BlockState state)
    {
        return state switch
        {
            Events.BlockState.Running => "#ffc107",
            Events.BlockState.Completed => "#28a745",
            Events.BlockState.Failed => "#dc3545",
            _ => "#6c757d"
        };
    }

    private static string FormatCount(long count) =>
        count >= 1_000_000 ? $"{count / 1_000_000.0:F1}M" :
        count >= 1_000     ? $"{count / 1_000.0:F1}k" :
        count.ToString();

    private string GenerateCurvedPath(double x1, double y1, double x2, double y2)
    {
        var midX = (x1 + x2) / 2;
        return $"M {x1} {y1} Q {midX} {y1}, {midX} {(y1 + y2) / 2} T {x2} {y2}";
    }
}
