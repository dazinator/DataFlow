<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PackageId>DataFlow</PackageId>
    <RootNamespace>DataFlow.POC</RootNamespace>
    <Title>DataFlow POC</Title>
    <Authors>Darrell Tunnell</Authors>
    <Company>Uniun Technology Ltd</Company>
    <Product>DataFlow</Product>
    <Description>DataFlow v2 POC - New edge-first design with epoch-based architecture. This package enables side-by-side migration from Uniun.DataFlow v1 to DataFlow v2.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/uniun-technology/dataflow</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="8.0.0" />
    <PackageReference Include="OpenTelemetry" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DataFlow.POC.Tests" />
    <InternalsVisibleTo Include="DataFlow.POC.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
